# 本机 Mac：只跑 Local Worker，Orchestrator 在服务器
# 用法: cp .env.local-worker.example .env 并填写密钥

LOCAL_WORKER_ENABLED=true
LOCAL_WORKER_TOKEN=change-me-local-worker-token
LOCAL_WORKER_ORCHESTRATOR_URL=http://111.231.5.52:8080
LOCAL_WORKER_POLL_SECONDS=5
# 远程 Worker 模式下任务里的 local_path 来自服务器 POLICY，本文件仅作参考/本地调试
POLICY_FILE=config/policy.example.json

# Claude Code（本机执行改代码）
ANTHROPIC_API_KEY=sk-kimi-xxxxxxxx
ANTHROPIC_BASE_URL=https://api.kimi.com/coding/
# Kimi K3（别名 K3 / kimi-k3）；默认 kimi-for-coding
ANTHROPIC_MODEL=k3

# GitLab MR（official-web-* 推 MR 时需要，与服务器可相同）
GITLAB_TOKEN=
GITLAB_API_BASE=https://gitlab.thinkingdata.cn/api/v4
