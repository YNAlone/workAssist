# 服务器：只跑 Orchestrator + Worker 任务队列（不要设 LOCAL_WORKER_ORCHESTRATOR_URL）
# 用法: cp .env.orchestrator.example .env 并填写密钥；Mac Worker 通过 HTTP claim 领任务

HOST=0.0.0.0
PORT=8080
CALLBACK_BASE_URL=http://111.231.5.52:8080
AUTOMATION_DRY_RUN=false

FEISHU_VERIFICATION_TOKEN=
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_BOT_WEBHOOK=
FEISHU_DOC_MOUNT_FOLDER=test

GITHUB_TOKEN=
GITHUB_WORKFLOW_ID=feishu-claude.yml
GITHUB_API_BASE=https://api.github.com
GITHUB_DISPATCH_REF=master

GITLAB_TOKEN=
GITLAB_API_BASE=https://gitlab.thinkingdata.cn/api/v4
GITLAB_DISPATCH_REF=main

# Orchestrator 意图解析（Kimi）
ORCH_LLM_API_KEY=sk-kimi-xxxxxxxx
ORCH_LLM_BASE_URL=https://api.kimi.com/coding/
ORCH_LLM_MODEL=k3

# 调度 GitHub/GitLab Runner 或写入 Worker 任务时使用的模型
ANTHROPIC_API_KEY=sk-kimi-xxxxxxxx
ANTHROPIC_BASE_URL=https://api.kimi.com/coding/
ANTHROPIC_MODEL=k3

# 启用 local_worker 执行器；队列在服务器磁盘，由远程 Mac claim
LOCAL_WORKER_ENABLED=true
LOCAL_WORKER_TOKEN=change-me-local-worker-token
LOCAL_WORKER_QUEUE_PATH=data/local_worker_queue.json
LOCAL_WORKER_POLL_SECONDS=5
# LOCAL_WORKER_ORCHESTRATOR_URL=   # 服务器留空

# 远程 Mac Worker：repo_catalog 里的 local_path 必须是 Mac 上的路径
POLICY_FILE=config/policy.remote-mac-worker.json

TASK_STORE_PATH=data/tasks.json
SESSION_STORE_PATH=data/sessions.json
SESSION_TTL_MINUTES=120
AUDIT_LOG_PATH=data/audit.log

DATABASE_URL=postgresql+psycopg://agent:agent@127.0.0.1:5432/agent_platform
AGENTS_FILE=config/agents.json
TOKEN_ENC_KEY=
