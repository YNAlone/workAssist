# 分拆部署（推荐）:
#   服务器 Orchestrator → cp .env.orchestrator.example .env
#   本机 Mac Worker     → cp .env.local-worker.example .env
# 单文件全量配置见下方（同机跑 Orchestrator + Worker 时用）

# Server
HOST=0.0.0.0
PORT=8080
CALLBACK_BASE_URL=https://orchestrator.example.com
AUTOMATION_DRY_RUN=false

# Feishu application bot
FEISHU_VERIFICATION_TOKEN=your_verification_token
FEISHU_APP_ID=cli_xxxxxxxx
FEISHU_APP_SECRET=your_app_secret
FEISHU_BOT_WEBHOOK=https://open.feishu.cn/open-apis/bot/v2/hook/xxxxxxxx
# Optional folder token for imported analysis docs (empty = resolve from FEISHU_DOC_MOUNT_FOLDER)
# FEISHU_DOC_MOUNT_KEY=
FEISHU_DOC_MOUNT_FOLDER=test
# Receive Feishu events through an outbound WebSocket instead of a public webhook.
# Keep false when using /feishu/events and /feishu/actions behind HTTPS.
FEISHU_LONG_CONNECTION_ENABLED=false

# GitHub
GITHUB_TOKEN=ghp_xxxxxxxx
GITHUB_WORKFLOW_ID=feishu-claude.yml
GITHUB_API_BASE=https://api.github.com
# Branch that contains the workflow file (required by workflow_dispatch ref)
GITHUB_DISPATCH_REF=dev_test

# GitLab (self-hosted or gitlab.com)
GITLAB_TOKEN=glpat-xxxxxxxx
GITLAB_API_BASE=https://gitlab.thinkingdata.cn/api/v4
# Branch that contains .gitlab-ci.yml (required by pipeline create ref)
GITLAB_DISPATCH_REF=main

# Orchestrator LLM (natural language intent)
# Use the same value as GitHub Secret ANTHROPIC_API_KEY (Kimi Key).
# If ORCH_LLM_API_KEY is empty, the app falls back to ANTHROPIC_API_KEY / KIMI_API_KEY.
ORCH_LLM_API_KEY=sk-kimi-xxxxxxxx
ORCH_LLM_BASE_URL=https://api.kimi.com/coding/
# Model choices: kimi-for-coding | k3 (alias: K3) | kimi-for-coding-highspeed
ORCH_LLM_MODEL=kimi-for-coding
# ORCH_LLM_MODEL=k3

# Optional local alias of the same Kimi Key
# ANTHROPIC_API_KEY=sk-kimi-xxxxxxxx

# Kimi Code for GitHub Actions / GitLab CI Runner
# Repository: Settings -> Secrets and variables -> Actions
# ANTHROPIC_API_KEY=sk-kimi-xxxxxxxx
# API base URL (already set in workflows): https://api.kimi.com/coding/
# Model is passed from ANTHROPIC_MODEL below when Orchestrator dispatches jobs.

# Local worker (optional on-machine executor)
LOCAL_WORKER_ENABLED=false
LOCAL_WORKER_TOKEN=change-me-local-worker-token
LOCAL_WORKER_QUEUE_PATH=data/local_worker_queue.json
LOCAL_WORKER_POLL_SECONDS=5
# Mac/remote worker: point to Orchestrator so claim goes over HTTP (leave empty when co-located)
# LOCAL_WORKER_ORCHESTRATOR_URL=http://111.231.5.52:8080

# Claude Code for local worker / CI dispatch (same Kimi key as orchestrator)
# ANTHROPIC_API_KEY=sk-kimi-xxxxxxxx
# ANTHROPIC_BASE_URL=https://api.kimi.com/coding/
# Model choices: kimi-for-coding | k3 (alias: K3) | kimi-for-coding-highspeed
ANTHROPIC_MODEL=kimi-for-coding
# ANTHROPIC_MODEL=k3

# Storage and policy
POLICY_FILE=config/policy.example.json
TASK_STORE_PATH=data/tasks.json
SESSION_STORE_PATH=data/sessions.json
SESSION_TTL_MINUTES=120
AUDIT_LOG_PATH=data/audit.log

# Multi-agent platform (M1+)
DATABASE_URL=postgresql+psycopg://agent:agent@127.0.0.1:5432/agent_platform
AGENTS_FILE=config/agents.json
TOKEN_ENC_KEY=

# Multi-bot Feishu apps (M3; optional for now)
# FEISHU_ORCH_APP_ID=
# FEISHU_ORCH_APP_SECRET=
# FEISHU_CODE_APP_ID=
# FEISHU_CODE_APP_SECRET=
# FEISHU_DOC_APP_ID=
# FEISHU_DOC_APP_SECRET=
# FEISHU_DOC_OAUTH_REDIRECT_URL=https://<host>/channels/feishu/doc/oauth/callback
# FEISHU_DOC_OAUTH_SCOPES=offline_access docx:document drive:drive wiki:wiki search:docs:read
# FEISHU_MCP_ALLOWED_TOOLS=fetch-doc,update-doc,create-doc,search-doc
