# Server
HOST=0.0.0.0
PORT=8080
CALLBACK_BASE_URL=https://orchestrator.example.com
AUTOMATION_DRY_RUN=false

# Feishu application bot
FEISHU_VERIFICATION_TOKEN=your_verification_token
FEISHU_APP_ID=cli_xxxxxxxx
FEISHU_APP_SECRET=your_app_secret
FEISHU_BOT_WEBHOOK=https://open.feishu.cn/open-apis/bot/v2/hook/xxxxxxxx

# GitHub
GITHUB_TOKEN=ghp_xxxxxxxx
GITHUB_WORKFLOW_ID=feishu-claude.yml
GITHUB_API_BASE=https://api.github.com

# Storage and policy
POLICY_FILE=config/policy.example.json
TASK_STORE_PATH=data/tasks.json
AUDIT_LOG_PATH=data/audit.log
