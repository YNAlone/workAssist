# Server
HOST=0.0.0.0
PORT=8080
CALLBACK_BASE_URL=https://orchestrator.example.com
AUTOMATION_DRY_RUN=false

# Feishu application bot
FEISHU_VERIFICATION_TOKEN=your_verification_token
FEISHU_APP_ID=cli_xxxxxxxx
FEISHU_APP_SECRET=your_app_secret
FEISHU_BOT_WEBHOOK=https://open.feishu.cn/open-apis/bot/v2/hook/xxxxxxxx

# GitHub
GITHUB_TOKEN=ghp_xxxxxxxx
GITHUB_WORKFLOW_ID=feishu-claude.yml
GITHUB_API_BASE=https://api.github.com
# Branch that contains the workflow file (required by workflow_dispatch ref)
GITHUB_DISPATCH_REF=dev_test

# Orchestrator LLM (natural language intent)
# Use the same value as GitHub Secret ANTHROPIC_API_KEY (Kimi Key).
# If ORCH_LLM_API_KEY is empty, the app falls back to ANTHROPIC_API_KEY / KIMI_API_KEY.
ORCH_LLM_API_KEY=sk-kimi-xxxxxxxx
ORCH_LLM_BASE_URL=https://api.kimi.com/coding/
ORCH_LLM_MODEL=kimi-for-coding

# Optional local alias of the same Kimi Key
# ANTHROPIC_API_KEY=sk-kimi-xxxxxxxx

# Kimi Code for GitHub Actions Runner (configure in GitHub repo Secrets)
# Repository: Settings -> Secrets and variables -> Actions
# ANTHROPIC_API_KEY=sk-kimi-xxxxxxxx
# API base URL (already set in .github/workflows/feishu-claude.yml):
# https://api.kimi.com/coding/

# Storage and policy
POLICY_FILE=config/policy.example.json
TASK_STORE_PATH=data/tasks.json
SESSION_STORE_PATH=data/sessions.json
SESSION_TTL_MINUTES=120
AUDIT_LOG_PATH=data/audit.log

# Multi-agent platform (M1+)
DATABASE_URL=postgresql+psycopg://agent:agent@127.0.0.1:5432/agent_platform
AGENTS_FILE=config/agents.json
TOKEN_ENC_KEY=

# Multi-bot Feishu apps (M3; optional for now)
# FEISHU_ORCH_APP_ID=
# FEISHU_ORCH_APP_SECRET=
# FEISHU_CODE_APP_ID=
# FEISHU_CODE_APP_SECRET=
# FEISHU_DOC_APP_ID=
# FEISHU_DOC_APP_SECRET=
# FEISHU_DOC_OAUTH_REDIRECT_URL=https://<host>/channels/feishu/doc/oauth/callback
# FEISHU_DOC_OAUTH_SCOPES=offline_access docx:document drive:drive wiki:wiki search:docs:read
# FEISHU_MCP_ALLOWED_TOOLS=fetch-doc,update-doc,create-doc,search-doc
